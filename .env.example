# Optional. Everything here can also be set on the Settings page (http://localhost:3000/settings).
# Values saved in the UI take precedence over these.

# Chat model: any OpenAI-compatible API. Default: DeepSeek.
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
CHAT_API_KEY=

# Embeddings: any OpenAI-compatible /embeddings API. Default: OpenRouter free tier.
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
EMBED_API_KEY=

# Where PDFs and the SQLite database are stored (default: ./data)
# DATA_DIR=./data
